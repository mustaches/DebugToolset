{
  "version": 1,
  "name": "gpu_effects_demo",
  "screenWidth": 480,
  "screenHeight": 272,
  "pages": [
    {
      "id": "page_home",
      "name": "主界面",
      "bgColor": 4278848020,
      "widgets": [
        {
          "id": "w_title",
          "type": "label",
          "name": "title",
          "x": 16.0,
          "y": 10.0,
          "width": 240.0,
          "height": 26.0,
          "props": {
            "text": "GPU 特效演示",
            "fontSize": 20,
            "color": 4294967295,
            "align": "left",
            "bold": true,
            "opacity": 90
          },
          "events": []
        },
        {
          "id": "w_badge",
          "type": "image",
          "name": "badge",
          "x": 410.0,
          "y": 8.0,
          "width": 48.0,
          "height": 48.0,
          "props": {
            "asset": null,
            "scaleMode": "fit",
            "rotate": 30,
            "scale": 120,
            "opacity": 85
          },
          "events": []
        },
        {
          "id": "w_menu",
          "type": "menu",
          "name": "main_menu",
          "x": 24.0,
          "y": 52.0,
          "width": 200.0,
          "height": 180.0,
          "props": {
            "items": "相机预览,参数设置,特效切换,系统信息,关于",
            "selectedIndex": 0,
            "itemExtent": 34,
            "fontSize": 15,
            "textColor": 4294967295,
            "highlightColor": 4278217052,
            "wrap": true
          },
          "events": [
            {
              "type": "onValueChange",
              "action": "callback",
              "callback": "on_menu_highlight"
            },
            {
              "type": "onClick",
              "action": "gotoPage",
              "callback": "",
              "targetPageId": "page_settings",
              "transition": "slideLeft"
            }
          ]
        },
        {
          "id": "w_progress",
          "type": "progress",
