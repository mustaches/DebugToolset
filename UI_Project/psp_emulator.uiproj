          "height": 18.0,
          "props": {
            "text": "模拟器",
            "fontSize": 12,
            "color": 4286556361,
            "align": "left",
            "bold": false
          },
          "events": []
        },
        {
          "id": "w_emu_list",
          "type": "scrolllist",
          "name": "emu_list",
          "x": 24.0,
          "y": 66.0,
          "width": 150.0,
          "height": 200.0,
          "props": {
            "orientation": "vertical",
            "items": "PSP,PS1,GBA,GBC,NDS,FC,SFC,MD,街机,N64",
            "itemExtent": 36,
            "spacing": 6,
            "selectedIndex": 0,
            "fontSize": 16,
            "textColor": 4294967295,
            "selectedColor": 4280191205
          },
          "events": [
            {
              "type": "onValueChange",
              "action": "callback",
              "callback": "on_emulator_changed"
