{
  "version": 1,
  "name": "psp_emulator",
  "screenWidth": 480,
  "screenHeight": 282,
  "pages": [
    {
      "id": "page_main",
      "name": "主界面",
      "bgColor": 4278195240,
      "widgets": [
        {
          "id": "w_topbar",
