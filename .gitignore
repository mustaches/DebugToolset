/BayerRGGB/
/IspFlow/BayerRGGB/

# DNG 原始图像（单张约 25MB，不入库）
*.dng

# scratch 下的编译产物（exe）
/scratch/*.exe

# ISP 冒烟测试输出
/scratch/isp_smoke_out/
Linux_setup/Output/

# IQA 权重导出产物（.nnw，一次性工具生成，不入库）
/tools/iqa/weights/

