+static void _fft_apply_window(float *io_buffer)
+{
+    for (int i = 0; i < FFT_WINDOW_SIZE; i++) {
+        io_buffer[2 * i] *= g_window_coeff[i];
+        io_buffer[2 * i + 1] *= g_window_coeff[i];
+    }
+}
