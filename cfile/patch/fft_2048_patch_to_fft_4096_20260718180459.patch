+static void _fft_init_hanning_window(void)
+{
+    if (g_window_initialized) {
+        return;
+    }
+    for (int i = 0; i < FFT_WINDOW_SIZE; i++) {
+        g_window_coeff[i] = (float)(0.5 - 0.5 * cos(2.0 * M_PI * i / (FFT_WINDOW_SIZE - 1)));
+    }
+    g_window_initialized = 1;
+}
