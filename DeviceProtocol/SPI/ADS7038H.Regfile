{
  "name": "ADS7038H",
  "hasSubaddress": true,
  "commands": {
    "0x00": {
      "name": "NOP",
      "access": "W",
      "description": "No operation"
    },
    "0x08": {
      "name": "Write",
      "access": "W",
      "description": "Single register write",
      "addrBytes": 1
    },
    "0x10": {
      "name": "Read",
      "access": "R",
      "description": "Single register read",
      "addrBytes": 1
    },
    "0x18": {
      "name": "Set Bit",
      "access": "W",
      "description": "Set bit in register",
      "addrBytes": 1
    },
    "0x20": {
      "name": "Clear Bit",
      "access": "W",
      "description": "Clear bit in register",
      "addrBytes": 1
    },
    "0x80": {
      "name": "On-the-fly-CH0-ID",
      "access": "W",
      "description": "On-the-fly Mode Channel 0 Selection"
    },
    "0x88": {
      "name": "On-the-fly-CH1-ID",
      "access": "W",
      "description": "On-the-fly Mode Channel 1 Selection"
    },
    "0x90": {
      "name": "On-the-fly-CH2-ID",
      "access": "W",
      "description": "On-the-fly Mode Channel 2 Selection"
    },
    "0x98": {
      "name": "On-the-fly-CH3-ID",
      "access": "W",
      "description": "On-the-fly Mode Channel 3 Selection"
    },
    "0xA0": {
      "name": "On-the-fly-CH4-ID",
      "access": "W",
      "description": "On-the-fly Mode Channel 4 Selection"
    },
    "0xA8": {
      "name": "On-the-fly-CH5-ID",
      "access": "W",
      "description": "On-the-fly Mode Channel 5 Selection"
    },
    "0xB0": {
      "name": "On-the-fly-CH6-ID",
      "access": "W",
      "description": "On-the-fly Mode Channel 6 Selection"
    },
    "0xB8": {
      "name": "On-the-fly-CH7-ID",
      "access": "W",
      "description": "On-the-fly Mode Channel 7 Selection"
    }
  },
  "registers": {
    "0x00": {
      "name": "SYSTEM_STATUS",
      "access": "R/W",
      "description": "0x0 SYSTEM_STATUS SYSTEM_STATUS Register (Address = 0x0) [reset = 0x81]",
      "fields": [
        {
          "name": "RSVD",
          "startBit": 7,
          "endBit": 7,
          "access": "R",
          "description": "Reads return 1b."
        },
        {
          "name": "SEQ STATUS _",
          "startBit": 6,
          "endBit": 6,
          "access": "R",
          "description": "Status of the channel sequencer. 0b = Sequence stopped 1b = Sequence in progress",
          "valueMap": {
            "0": "Sequence stopped",
            "1": "Sequence in progress"
          }
        },
        {
          "name": "CRCERR FUSE _",
          "startBit": 2,
          "endBit": 2,
          "access": "R",
          "description": "Device power-up configuration CRC check status. To re-evaluate this bit, software reset the device or power cycle AVDD. 0b = No problems detected in power-up configuration. 1b = Device configuration not loaded correctly.",
          "valueMap": {
            "0": "No problems detected in power-up configuration.",
            "1": "Device configuration not loaded correctly."
          }
        },
        {
          "name": "CRCERR IN _",
          "startBit": 1,
          "endBit": 1,
          "access": "R/W",
          "description": "Status of CRC check on incoming data. Write 1b to clear this error flag. 0b = No CRC error. 1b = CRC error detected. All register writes, except to addresses 0x00 and 0x01, are blocked.",
          "valueMap": {
            "0": "No CRC error.",
            "1": "CRC error detected. All register writes, except to addresses 0x00 and 0x01, are blocked."
          }
        },
        {
          "name": "BOR",
          "startBit": 0,
          "endBit": 0,
          "access": "R/W",
          "description": "Brown out reset indicator. This bit is set if brown out condition occurs or device is power cycled. Write 1b to this bit to clear the flag. 0b = No brown out from the last time this bit was cleared. 1b = Brown out condition detected or device power cycled.",
          "valueMap": {
            "0": "No brown out from the last time this bit was cleared.",
            "1": "Brown out condition detected or device power cycled."
          }
        }
      ]
    },
    "0x01": {
      "name": "GENERAL_CFG",
      "access": "R/W",
      "description": "0x1 GENERAL_CFG GENERAL_CFG Register (Address = 0x1) [reset = 0x0]",
      "fields": [
        {
          "name": "CRC EN _",
          "startBit": 6,
          "endBit": 6,
          "access": "R/W",
          "description": "Enable or disable the CRC on device interface. 0b = CRC module disabled. 1b = CRC appended to data output. CRC check is enabled on incoming data.",
          "valueMap": {
            "0": "CRC module disabled.",
            "1": "CRC appended to data output. CRC check is enabled on incoming data."
          }
        },
        {
          "name": "STATS EN _",
          "startBit": 5,
          "endBit": 5,
          "access": "R/W",
          "description": "Enable or disable the statistics module. 0b = Minimum, maximum, and recent value registers are not updated. 1b = Clear minimum, maximum, and recent value registers and conitnue updating with new conversion results.",
          "valueMap": {
            "0": "Minimum, maximum, and recent value registers are not updated.",
            "1": "Clear minimum, maximum, and recent value registers and conitnue updating with new conversion results."
          }
        }
      ]
    },
    "0x02": {
      "name": "DATA_CFG",
      "access": "R/W",
      "description": "0x2 DATA_CFG DATA_CFG Register (Address = 0x2) [reset = 0x0]",
      "fields": [
        {
          "name": "FIX PAT _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Device outputs fixed data bits which can be helpful for debugging communication with the device. 0b = Normal operation. 1b = Device outputs fixed code 0xA5A repeatitively when reading ADC data.",
          "valueMap": {
            "0": "Normal operation.",
            "1": "Device outputs fixed code 0xA5A repeatitively when reading ADC data."
          }
        },
        {
          "name": "APPEND STATUS[1:0] _",
          "startBit": 5,
          "endBit": 5,
          "access": "R/W",
          "description": "Append 4-bit channel ID or status flags to output data. 00b: 01b: 10b: 11b: 0b = Channel ID and status flags are not appended to ADC data. 1b = 4-bit channel ID is appended to ADC data. 10b = 4-bit status flags are appended to ADC data. 11b = Reserved.",
          "valueMap": {
            "0": "Channel ID and status flags are not appended to ADC data.",
            "1": "4-bit channel ID is appended to ADC data.",
            "2": "4-bit status flags are appended to ADC data.",
            "3": "Reserved."
          }
        },
        {
          "name": "CPOL CPHA[1:0] _",
          "startBit": 1,
          "endBit": 1,
          "access": "R/W",
          "description": "This field sets the polarity and phase of SPI communication. 0b = CPOL = 0, CPHA = 0. 1b = CPOL = 0, CPHA = 1. 10b = CPOL = 1, CPHA = 0. 11b = CPOL = 1, CPHA = 1."
        }
      ]
    },
    "0x03": {
      "name": "OSR_CFG",
      "access": "R/W",
      "description": "0x3 OSR_CFG OSR_CFG Register (Address = 0x3) [reset = 0x0]",
      "fields": [
        {
          "name": "OSR[2:0]",
          "startBit": 2,
          "endBit": 2,
          "access": "R/W",
          "description": "Selects the oversampling ratio for ADC conversion result. 0b = No averaging 1b = 2 samples 10b = 4 samples 11b = 8 samples 100b = 16 samples 101b = 32 samples 110b = 64 samples 111b = 128 samples",
          "valueMap": {
            "0": "No averaging",
            "1": "2 samples",
            "2": "4 samples",
            "3": "8 samples",
            "4": "16 samples",
            "5": "32 samples",
            "6": "64 samples",
            "7": "128 samples"
          }
        }
      ]
    },
    "0x04": {
      "name": "OPMODE_CFG",
      "access": "R/W",
      "description": "0x4 OPMODE_CFG OPMODE_CFG Register (Address = 0x4) [reset = 0x0]",
      "fields": [
        {
          "name": "CONV ON ERR _ _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Control continuation of autonomous modes if CRC error is detected on communication interface. 0b = If CRC error is detected, device continues channel sequencing and pin configuration is retained. See the CRCERR IN bit for more details. _ 1b = If CRC error is detected, devicel changes all channels to analog inpts and channel sequencing is paused until CRCERR IN = 1b. After clearing _ CRCERR IN flag, device resumes channel sequencing and pin confguration is _ restored.",
          "valueMap": {
            "0": "If CRC error is detected, device continues channel sequencing and pin configuration is retained. See the CRCERR IN bit for more details. _"
          }
        },
        {
          "name": "CONV MODE[1:0] _",
          "startBit": 6,
          "endBit": 6,
          "access": "R/W",
          "description": "These bits set the mode of conversion of the ADC. 0b = Manual mode; conversions are initiated by host. 1b = Autonomous mode; conversions are initiated by the internal state machine.",
          "valueMap": {
            "0": "Manual mode; conversions are initiated by host.",
            "1": "Autonomous mode; conversions are initiated by the internal state machine."
          }
        },
        {
          "name": "OSC SEL _",
          "startBit": 4,
          "endBit": 4,
          "access": "R/W",
          "description": "Selects the oscillator for internal timing generation. 0b = High-speed oscillator. 1b = Low-power oscillator.",
          "valueMap": {
            "0": "High-speed oscillator.",
            "1": "Low-power oscillator."
          }
        },
        {
          "name": "CLK DIV[3:0] _",
          "startBit": 3,
          "endBit": 3,
          "access": "R/W",
          "description": "Sampling speed control in autonomous monitoring mode (CONV MODE = _ 01b). See the section on oscillator and timing control for details."
        }
      ]
    },
    "0x05": {
      "name": "PIN_CFG",
      "access": "R/W",
      "description": "0x5 PIN_CFG PIN_CFG Register (Address = 0x5) [reset = 0x0]",
      "fields": [
        {
          "name": "PIN CFG[7:0] _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Configure device channels AIN / GPIO [7:0] as analog inputs or GPIOs. 0b = Channel is configured as analog input. 1b = Channel is configured as GPIO.",
          "valueMap": {
            "0": "Channel is configured as analog input.",
            "1": "Channel is configured as GPIO."
          }
        }
      ]
    },
    "0x07": {
      "name": "GPIO_CFG",
      "access": "R/W",
      "description": "0x7 GPIO_CFG GPIO_CFG Register (Address = 0x7) [reset = 0x0]",
      "fields": [
        {
          "name": "GPIO CFG[7:0] _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Configure GPIO[7:0] as either digital inputs or digital outputs. 0b = GPIO is configured as digital input. 1b = GPIO is configured as digital output.",
          "valueMap": {
            "0": "GPIO is configured as digital input.",
            "1": "GPIO is configured as digital output."
          }
        }
      ]
    },
    "0x09": {
      "name": "GPO_DRIVE_CFG",
      "access": "R/W",
      "description": "0x9 GPO_DRIVE_CFG GPO_DRIVE_CFG Register (Address = 0x9) [reset = 0x0]",
      "fields": [
        {
          "name": "GPO DRIVE CFG[7:0] _ _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Configure digital outputs GPO[7:0] as open-drain or push-pull outputs. 0b = Digital output is open-drain; connect external pullup resistor. 1b = Push-pull driver is used for digital output.",
          "valueMap": {
            "0": "Digital output is open-drain; connect external pullup resistor.",
            "1": "Push-pull driver is used for digital output."
          }
        }
      ]
    },
    "0x0B": {
      "name": "GPO_VALUE",
      "access": "R/W",
      "description": "0xB GPO_VALUE GPO_VALUE Register (Address = 0xB) [reset = 0x0]",
      "fields": [
        {
          "name": "GPO VALUE[7:0] _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Logic level to be set on digital outputs GPO[7:0]. 0b = Digital output set to logic 0. 1b = Digital output set to logic 1.",
          "valueMap": {
            "0": "Digital output set to logic 0.",
            "1": "Digital output set to logic 1."
          }
        }
      ]
    },
    "0x0D": {
      "name": "GPI_VALUE",
      "access": "R/W",
      "description": "0xD GPI_VALUE GPI_VALUE Register (Address = 0xD) [reset = 0x0]",
      "fields": [
        {
          "name": "GPI VALUE[7:0] _",
          "startBit": 7,
          "endBit": 7,
          "access": "R",
          "description": "Readback the logic level on GPIO[7:0]. 0b = GPIO is at logic 0. 1b = GPIO is at logic 1.",
          "valueMap": {
            "0": "GPIO is at logic 0.",
            "1": "GPIO is at logic 1."
          }
        }
      ]
    },
    "0x10": {
      "name": "SEQUENCE_CFG",
      "access": "R/W",
      "description": "0x10 SEQUENCE_CFG SEQUENCE_CFG Register (Address = 0x10) [reset = 0x0]",
      "fields": [
        {
          "name": "SEQ START _",
          "startBit": 4,
          "endBit": 4,
          "access": "R/W",
          "description": "Control for start of channel sequence when using auto sequence mode (SEQ MODE = 01b). _ 0b = Stop channel sequencing. 1b = Start channel sequencing in ascending order for channels enabled in AUTO SEQ CHSEL register. _ _",
          "valueMap": {
            "0": "Stop channel sequencing.",
            "1": "Start channel sequencing in ascending order for channels enabled in AUTO SEQ CHSEL register. _ _"
          }
        }
      ]
    },
    "0x11": {
      "name": "CHANNEL_SEL",
      "access": "R/W",
      "description": "0x11 CHANNEL_SEL CHANNEL_SEL Register (Address = 0x11) [reset = 0x0]",
      "fields": [
        {
          "name": "MANUAL CHID[3:0] _",
          "startBit": 3,
          "endBit": 3,
          "access": "R/W",
          "description": "In manual mode (SEQ MODE = 00b), this field contains the 4-bit _ channel ID of the analog input channel for next ADC conversion. For valid ADC data, the selected channel must not be configured as GPIO in PIN CFG register. 1xxx = Reserved. _ 0b = AIN0 1b = AIN1 10b = AIN2 11b = AIN3 100b = AIN4 101b = AIN5 110b = AIN6 111b = AIN7",
          "valueMap": {
            "0": "AIN0",
            "1": "AIN1",
            "2": "AIN2",
            "3": "AIN3",
            "4": "AIN4",
            "5": "AIN5",
            "6": "AIN6",
            "7": "AIN7"
          }
        }
      ]
    },
    "0x12": {
      "name": "AUTO_SEQ_CH_SEL",
      "access": "R/W",
      "description": "0x12 AUTO_SEQ_CH_SEL AUTO_SEQ_CH_SEL Register (Address = 0x12) [reset = 0x0]",
      "fields": [
        {
          "name": "AUTO SEQ CH SEL[7:0] _ _ _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Select analog input channels AIN[7:0] in for auto sequencing mode. 0b = Analog input channel is not enabled in scanning sequence. 1b = Analog input channel is enabled in scanning sequence.",
          "valueMap": {
            "0": "Analog input channel is not enabled in scanning sequence.",
            "1": "Analog input channel is enabled in scanning sequence."
          }
        }
      ]
    },
    "0x14": {
      "name": "ALERT_CH_SEL",
      "access": "R/W",
      "description": "0x14 ALERT_CH_SEL ALERT_CH_SEL Register (Address = 0x14) [reset = 0x0]",
      "fields": [
        {
          "name": "ALERT CH SEL[7:0] _ _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Select channels for which the alert flags can assert the internal ALERT signal. The ALERT signal can be mapped to the digital output channel configured in the ALERT PIN[3:0] field. _ 0b = Alert flags for this channel do not assert the ALERT pin. 1b = Alert flags for this channel assert the ALERT pin.",
          "valueMap": {
            "0": "Alert flags for this channel do not assert the ALERT pin.",
            "1": "Alert flags for this channel assert the ALERT pin."
          }
        }
      ]
    },
    "0x16": {
      "name": "ALERT_MAP",
      "access": "R/W",
      "description": "0x16 ALERT_MAP ALERT_MAP Register (Address = 0x16) [reset = 0x0]",
      "fields": [
        {
          "name": "ALERT CRCIN _",
          "startBit": 0,
          "endBit": 0,
          "access": "R/W",
          "description": "Enable or disable the alert notification for CRC error on input data (CRCERR IN = 1b). _ 0b = ALERT signal is not asserted when CRCERR IN = 1b. _ 1b = ALERT signal is asserted when CRCERR IN = 1b. Clear _ CRCERR IN for deasserting the ALERT pin. _"
        }
      ]
    },
    "0x17": {
      "name": "ALERT_PIN_CFG",
      "access": "R/W",
      "description": "0x17 ALERT_PIN_CFG ALERT_PIN_CFG Register (Address = 0x17) [reset = 0x0]",
      "fields": [
        {
          "name": "ALERT PIN[3:0] _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Internal ALERT output of the digital window comparator will be output on this channel. This channel must be configured as digital output."
        }
      ]
    },
    "0x18": {
      "name": "EVENT_FLAG",
      "access": "R/W",
      "description": "0x18 EVENT_FLAG EVENT_FLAG Register (Address = 0x18) [reset = 0x0]",
      "fields": [
        {
          "name": "EVENT FLAG[7:0] _",
          "startBit": 7,
          "endBit": 7,
          "access": "R",
          "description": "Alert flags indicating digital window comparator status for CH[7:0]. Clear individual bits of EVENT HIGH FLAG or EVENT LOW FLAG registers to clear the corresponding alert flag. _ _ _ _ 0b = Event condition not detected. 1b = Event condition detected.",
          "valueMap": {
            "0": "Event condition not detected.",
            "1": "Event condition detected."
          }
        }
      ]
    },
    "0x1A": {
      "name": "EVENT_HIGH_FLAG",
      "access": "R/W",
      "description": "0x1A EVENT_HIGH_FLAG EVENT_HIGH_FLAG Register (Address = 0x1A) [reset = 0x0]",
      "fields": [
        {
          "name": "EVENT HIGH FLAG[7:0] _ _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Alert flag corresponding to high threshold of analog input or rising edge of digital input on CH[7:0]. Write 1b to clear this flag. 0b = No alert condition detected. 1b = Either high threshold was exceeded (analog input) or rising edge was detected (digital input).",
          "valueMap": {
            "0": "No alert condition detected.",
            "1": "Either high threshold was exceeded (analog input) or rising edge was detected (digital input)."
          }
        }
      ]
    },
    "0x1C": {
      "name": "EVENT_LOW_FLAG",
      "access": "R/W",
      "description": "0x1C EVENT_LOW_FLAG EVENT_LOW_FLAG Register (Address = 0x1C) [reset = 0x0]",
      "fields": []
    },
    "0x1E": {
      "name": "EVENT_RGN",
      "access": "R/W",
      "description": "0x1E EVENT_RGN EVENT_RGN Register (Address = 0x1E) [reset = 0x0]",
      "fields": [
        {
          "name": "EVENT RGN[7:0] _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Choice of region used in monitoring analog/digital inputs CH[7:0]. 0b = Alert flag is set if: (conversion result < low threshold) or (conversion result > high threshold). For digital inputs, logic 1 sets the alert flag. 1b = Alert flag is set if: (low threshold > conversion result < high threshold). For digital inputs, logic 0 sets the alert flag.",
          "valueMap": {
            "0": "Alert flag is set if: (conversion result < low threshold) or (conversion result > high threshold). For digital inputs, logic 1 sets the alert flag.",
            "1": "Alert flag is set if: (low threshold > conversion result < high threshold). For digital inputs, logic 0 sets the alert flag."
          }
        }
      ]
    },
    "0x20": {
      "name": "HYSTERESIS_CH0",
      "access": "R/W",
      "description": "0x20 HYSTERESIS_CH0 HYSTERESIS_CH0 Register (Address = 0x20) [reset = 0xF0]",
      "fields": [
        {
          "name": "HIGH THRESHOLD CH0 LSB[3:0 _ _ _ ]",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Lower 4-bits of high threshold for analog input. These bits are compared with bits 3:0 of ADC conversion result."
        },
        {
          "name": "HYSTERESIS CH0[3:0] _",
          "startBit": 3,
          "endBit": 3,
          "access": "R/W",
          "description": "4-bit hysteresis for high and low thresholds. This 4-bit hysteris is left shifted 3 times and applied on the lower 7-bits of the threshold. Total hysteresis = 7-bits [4-bits, 000b]"
        }
      ]
    },
    "0x21": {
      "name": "HIGH_TH_CH0",
      "access": "R/W",
      "description": "0x21 HIGH_TH_CH0 HIGH_TH_CH0 Register (Address = 0x21) [reset = 0xFF]",
      "fields": []
    },
    "0x22": {
      "name": "EVENT_COUNT_CH0",
      "access": "R/W",
      "description": "0x22 EVENT_COUNT_CH0 EVENT_COUNT_CH0 Register (Address = 0x22) [reset = 0x0]",
      "fields": [
        {
          "name": "LOW THRESHOLD CH0 _ _ LSB[3:0] _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Lower 4-bits of low threshold for analog input. These bits are compared with bits 3:0 of ADC conversion result."
        },
        {
          "name": "EVENT COUNT CH0[3:0 _ _ ]",
          "startBit": 3,
          "endBit": 3,
          "access": "R/W",
          "description": "Configuration for checking 'n+1' consecutive samples above threshold before setting alert flag."
        }
      ]
    },
    "0x23": {
      "name": "LOW_TH_CH0",
      "access": "R/W",
      "description": "0x23 LOW_TH_CH0 LOW_TH_CH0 Register (Address = 0x23) [reset = 0x0]",
      "fields": [
        {
          "name": "LOW THRESHOLD CH0 _ _ MSB[7:0] _",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "MSB aligned high threshold for analog input. These bits are compared with top 8 bits of ADC conversion result."
        }
      ]
    },
    "0x24": {
      "name": "HYSTERESIS_CH1",
      "access": "R/W",
      "description": "0x24 HYSTERESIS_CH1 HYSTERESIS_CH1 Register (Address = 0x24) [reset = 0xF0]",
      "fields": [
        {
          "name": "HIGH THRESHOLD CH1 LS _ _ _ B[3:0]",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "Lower 4-bits of high threshold for analog input. These bits are compared with bits 3:0 of ADC conversion result."
        },
        {
          "name": "HYSTERESIS CH1[3:0] _",
          "startBit": 3,
          "endBit": 3,
          "access": "R/W",
          "description": "4-bit hysteresis for high and low thresholds. This 4-bit hysteris is left shifted 3 times and applied on the lower 7-bits of the threshold. Total hysteresis = 7-bits [4-bits, 000b]"
        }
      ]
    },
    "0x25": {
      "name": "HIGH_TH_CH1",
      "access": "R/W",
      "description": "0x25 HIGH_TH_CH1 HIGH_TH_CH1 Register (Address = 0x25) [reset = 0xFF]",
      "fields": [
        {
          "name": "HIGH THRESHOLD CH1 M _ _ _ SB[7:0]",
          "startBit": 7,
          "endBit": 7,
          "access": "R/W",
          "description": "MSB aligned high threshold for analog input. These bits are compared with top 8 bits of ADC conversion result."
        }
      ]
    },
    "0x26": {
      "name": "EVENT_COUNT_CH1",
      "access": "R/W",
      "description": "0x26 EVENT_COUNT_CH1 EVENT_COUNT_CH1 Register (Address = 0x26) [reset = 0x0]",
      "fields": [
        {
          "name": "LOW THRESHOLD CH1 LS _ _ _ B[3:0]",
          "startBit": 7,
